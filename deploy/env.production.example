# ─────────────────────────────────────────────────────────────────────────────
#  Production environment for the station — install as
#  /etc/anomalradio/anomalradio.env  with mode 600, owned by root.
#
#  deploy/bin/deploy.sh creates this from the template on first run and fills in
#  SECRET with 32 random bytes. Nothing in this file is ever committed.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# 64 hex characters. Required in production: the server refuses to boot without it,
# because a guessable secret means anyone can mint their own stream tokens.
#   openssl rand -hex 32
SECRET=

# The only origins allowed to mint stream tokens. This is what blocks hotlinking.
ALLOWED_ORIGINS=https://anomalradio.com,https://www.anomalradio.com,https://*.anomalradio.com

# nginx sits in front, so the real client IP arrives in X-Forwarded-For.
# The app only trusts that header when the immediate peer is loopback.
TRUST_PROXY=true

# ── state: everything writable lives under one directory ──
# The systemd unit confines the service to this path (ReadWritePaths).
DATA_DIR=/var/lib/anomalradio/data
ANOMALRADIO_DB=/var/lib/anomalradio/data/anomalradio.db
LIBRARY_INDEX=/var/lib/anomalradio/data/tracks.json
# Private masters. NEVER inside the repository or a web root.
MEDIA_DIR=/var/lib/anomalradio/media
STORAGE_DRIVER=local

# Where `npm run import -- --publish` looks for new mp3s (scp them here).
LIBRARY_SOURCE_DIR=/srv/anomalradio-inbox

# ── the continuous stream ──
# Keep MOUNT_PATH in sync with the location block in deploy/nginx/anomalradio.conf.
MOUNT_PATH=/radio-128.mp3
# Nominal bitrate advertised to players. The mount carries each master at its own
# bitrate, so this is a label for players and the .pls/.m3u files.
STREAM_BITRATE=128
ICY_METAINT=16384
RADIO_TOKEN_TTL=21600
LISTENER_BUFFER_LIMIT=1048576

# ── gating ──
STREAM_TOKEN_TTL=120
MAX_REQUESTS_PER_TOKEN=400
MAX_STREAMS_PER_IP=3
SESSION_RATE_LIMIT=60
AUDIO_RATE_LIMIT=600
BLOCKED_USER_AGENTS=streamripper,ffmpeg,ffprobe,wget,curl,python-requests,yt-dlp,aria2,HTTrack,IDM

# ── a 10 TB/month free egress budget is not a licence to be careless ──
# One 320 kbps listener costs ~144 MB/hour, so ~96 listeners running 24/7 would
# consume the whole Always Free allowance. See deploy/README.md for the table.
DEMO_TIME_SCALE=1

# ── later milestones ──
ADMIN_PATH=/admin
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_IP_ALLOWLIST=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=EUR
DEFAULT_PRICE_CENTS=199
