# ─────────────────────────────────────────────────────────────
#  Anomalradio environment — copy to `.env` and fill in.
#  The app runs without .env in development (safe defaults).
# ─────────────────────────────────────────────────────────────

# ── Server ──
NODE_ENV=development
PORT=3000
# Public origin(s) allowed to request stream tokens (comma separated).
# Wildcards for subdomains are supported: https://*.anomalradio.com
ALLOWED_ORIGINS=http://localhost:3000,https://anomalradio.com,https://*.anomalradio.com

# ── Data ──
# SQLite database: the catalogue, favourites, baskets, issued tokens.
ANOMALRADIO_DB=./data/anomalradio.db
# Human-readable metadata export written by `npm run import` (server-side, committed).
LIBRARY_INDEX=./data/tracks.json
# Where you drop new music for `npm run import`. NEVER inside public/.
LIBRARY_SOURCE_DIR=./_data/music

# ── Security ──
# 32+ random bytes, hex. REQUIRED in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=
# Lifetime of a stream token in seconds (short on purpose).
STREAM_TOKEN_TTL=120
# How many HTTP requests one token may serve. Seeking needs a handful; a ripper
# looping over byte ranges blows past this and gets cut off.
MAX_REQUESTS_PER_TOKEN=400
# Max simultaneous audio streams per IP.
MAX_STREAMS_PER_IP=3
# Rate limits, requests per minute per IP.
SESSION_RATE_LIMIT=60
AUDIO_RATE_LIMIT=600
# Comma separated User-Agent fragments blocked on audio routes.
BLOCKED_USER_AGENTS=streamripper,ffmpeg,ffprobe,wget,curl,python-requests,yt-dlp,aria2,HTTrack,IDM

# ── Media storage ──
# local = files under MEDIA_DIR on this server (outside the web root)
# s3    = any S3-compatible private bucket (Cloudflare R2, B2, Wasabi, MinIO, AWS)
STORAGE_DRIVER=local
MEDIA_DIR=./media
# Only used when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# proxy    = the server streams objects itself, so the bucket host never reaches the browser
# redirect = answer 302 with a short-lived presigned URL (cheaper on app bandwidth)
S3_PROXY=true
S3_SIGNED_URL_TTL=60
# Path style is what MinIO and most self-hosted gateways expect.
S3_FORCE_PATH_STYLE=true

# ── Continuous stream (M3) ──
# The mount: one endless response, fanned out to every listener.
MOUNT_PATH=/radio-128.mp3
# Nominal bitrate advertised to players (the stream carries each master at its own bitrate).
STREAM_BITRATE=128
# Bytes of audio between ICY metadata blocks — this is what makes players show the track title.
ICY_METAINT=16384
# A live listener holds one long connection, so its token lasts hours rather than minutes.
RADIO_TOKEN_TTL=21600
# A listener further behind than this is dropped instead of buffered forever.
LISTENER_BUFFER_LIMIT=1048576

# ── Prototype behaviour ──
# Speed of the schedule (1 = real time). Only useful for demos and tests.
DEMO_TIME_SCALE=1

# ── Admin (M6) ──
ADMIN_PATH=/admin
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_IP_ALLOWLIST=

# ── Shop (M5) — leave empty to use external buy links only ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=EUR
DEFAULT_PRICE_CENTS=199
