# ─────────────────────────────────────────────────────────────
#  Anomalradio environment — copy to `.env` and fill in.
#  The app runs without .env in dev (safe defaults below).
# ─────────────────────────────────────────────────────────────

# ── Server ──
NODE_ENV=development
PORT=3000
# Public origin(s) allowed to request stream tokens (comma separated).
# Wildcards for subdomains are supported: https://*.anomalradio.com
ALLOWED_ORIGINS=http://localhost:3000,https://anomalradio.com,https://*.anomalradio.com

# ── Security ──
# 32+ random bytes, hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=
# Lifetime of a stream token in seconds (short on purpose).
STREAM_TOKEN_TTL=120
# Max simultaneous audio streams per IP.
MAX_STREAMS_PER_IP=3
# Rate limit for /api/session (requests per minute per IP).
SESSION_RATE_LIMIT=60
# Comma separated User-Agent fragments blocked on audio routes.
BLOCKED_USER_AGENTS=streamripper,ffmpeg,ffprobe,wget,curl,python-requests,yt-dlp,aria2,HTTrack,IDM

# ── Media storage ──
# local = files under ./media on this server   |   s3 = private object storage
STORAGE_DRIVER=local
MEDIA_DIR=./media
# Only used when STORAGE_DRIVER=s3 (Cloudflare R2 / S3 / B2 / Wasabi / MinIO)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Presigned URL lifetime in seconds when the s3 driver redirects instead of proxying.
S3_SIGNED_URL_TTL=60

# ── Library source (dev/prototype only) ──
# Where the music you drop for import lives. NEVER inside public/.
LIBRARY_SOURCE_DIR=./_data/music
# Library metadata file generated by `npm run import`.
LIBRARY_INDEX=./data/tracks.json
# Prototype only: playback speed of the simulated broadcast clock (1 = real time).
DEMO_TIME_SCALE=1

# ── Live radio (M3) ──
ICECAST_HOST=127.0.0.1
ICECAST_PORT=8000
ICECAST_MOUNT=/radio-128.mp3
ICECAST_SOURCE_PASSWORD=
ICECAST_ADMIN_PASSWORD=
ICECAST_PUBLIC_HOST=stream.anomalradio.com

# ── Admin (M6) ──
ADMIN_PATH=/admin
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_IP_ALLOWLIST=

# ── Shop (M5) — leave empty to use external buy links only ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=EUR
DEFAULT_PRICE_CENTS=199
